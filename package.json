{
  "name": "xats-setup",
  "version": "0.3.7",
  "description": "One-command, OS-agnostic installer for the xats cross-agent bus with optional secure direct peer networking. Windows, macOS, Linux.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abdk4Moura/xats-setup.git"
  },
  "bin": {
    "xats-setup": "install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build:daemon": "esbuild daemon/src/cli.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:fastify --external:@modelcontextprotocol/sdk --external:zod --external:json-schema-diff-validator --outfile=daemon/dist/cli.js",
    "prepublishOnly": "npm run build:daemon"
  },
  "files": [
    "install.mjs",
    "lib/",
    "assets/",
    "docs/",
    "README.md",
    "daemon/",
    "scripts/"
  ],
  "keywords": [
    "xats",
    "cross-agent-teams",
    "installer",
    "cross-platform"
  ],
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "1.4.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "cross-agent-teams-mcp": "0.7.4",
    "esbuild": "^0.25.12"
  }
}
